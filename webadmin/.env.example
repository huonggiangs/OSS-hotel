# Copy file này thành .env ở thư mục gốc webadmin/ trước khi chạy `docker compose up`.
#
# LƯU Ý: file này CHỈ cần cho Cách 2 (chạy qua Docker) hoặc khi bạn chủ động muốn
# `database/migrate.ts`/`database/seed.ts` kết nối PostgreSQL thật (không qua Docker).
# Cách 1 — chạy `apps/api` trực tiếp bằng `npm run dev` (chế độ database embedded,
# không cần Docker/PostgreSQL) — KHÔNG cần file `.env` nào, mặc định tự bật
# DB_MODE=embedded khi không có DATABASE_URL. Xem README.md mục "Chạy".

# Bắt buộc đổi trước khi dùng cho môi trường thật — không dùng giá trị mặc định.
JWT_SECRET=please-change-this-to-a-long-random-string

# Dùng khi chạy từng app riêng lẻ VỚI PostgreSQL thật (không qua docker compose),
# ví dụ `npm run migrate`/`npm run seed` trong database/, hoặc muốn ép apps/api
# dùng Postgres thật thay vì embedded — copy phần này thành apps/api/.env riêng.
DATABASE_URL=postgresql://hq_console:hq_console@localhost:5432/hq_console?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
