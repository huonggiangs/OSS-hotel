# Copy file này thành .env ở thư mục gốc webadmin/ trước khi chạy docker compose.

# Bắt buộc đổi trước khi dùng cho môi trường thật — không dùng giá trị mặc định.
JWT_SECRET=please-change-this-to-a-long-random-string

# Dùng khi chạy từng app riêng lẻ (không qua docker compose), ví dụ `npm run dev`
# trong apps/api hoặc database/.
DATABASE_URL=postgresql://hq_console:hq_console@localhost:5432/hq_console?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
