# Copy file này thành .env ở thư mục gốc property-web/ trước khi chạy docker compose.
#
# LƯU Ý: nếu chỉ chạy `npm run dev` trực tiếp trong apps/api (KHÔNG dùng Docker),
# KHÔNG BẮT BUỘC phải tạo file .env — để trống DATABASE_URL, API sẽ tự dùng chế
# độ database "embedded" (PGlite, không cần Docker/PostgreSQL, tự lưu ra thư mục
# apps/api/.data/). Xem README.md mục "Chạy thử — Cách 1 (không cần Docker)".

# Bắt buộc đổi trước khi dùng cho môi trường thật — không dùng giá trị mặc định.
JWT_SECRET=please-change-this-to-a-long-random-string

# DB_MODE: "postgres" (dùng DATABASE_URL bên dưới, kết nối PostgreSQL thật — qua
# docker compose) hoặc "embedded" (dùng PGlite, không cần Docker/PostgreSQL).
# Nếu để trống DB_MODE: tự chọn "postgres" khi có DATABASE_URL, ngược lại "embedded".
DB_MODE=postgres

# Dùng khi chạy từng app riêng lẻ (không qua docker compose), ví dụ `npm run dev`
# trong apps/api hoặc database/. Chỉ cần khi DB_MODE=postgres.
DATABASE_URL=postgresql://property_web:property_web@localhost:5433/property_web?schema=public
PORT=4100
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100
