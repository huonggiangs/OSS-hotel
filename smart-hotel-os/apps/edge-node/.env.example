# ============================================================================
# edge-node — biến môi trường (copy sang .env nếu cần chỉnh, KHÔNG commit .env)
# ============================================================================

# Cổng lắng nghe HTTP — BẮT BUỘC bind 0.0.0.0 (xem src/index.ts) để bất kỳ
# thiết bị nào trong cùng mạng LAN khách sạn (máy tính khác, điện thoại) đều
# truy cập được qua http://<ip-lan-cua-edge-node>:4200, không chỉ localhost.
PORT=4200

# "embedded" (mặc định, dùng PGlite — không cần Docker/PostgreSQL, tự tạo dữ
# liệu tại apps/edge-node/.data/edge-node-db) hoặc "postgres" (cần DATABASE_URL).
DB_MODE=embedded
# DATABASE_URL=postgresql://edge_node:edge_node@localhost:5432/edge_node

# Địa chỉ Cloud property-web API (nguồn sự thật — xem README.md mục "Mô hình
# đồng bộ"). Đổi thành IP/domain thật của Cloud khi triển khai thực tế.
CLOUD_PROPERTY_API_URL=http://localhost:4100

# Định danh tenant/property/edge-node — PHẢI khớp với property_id thật trên
# Cloud property-web để đồng bộ đúng dữ liệu (mặc định khớp property demo
# "ANIO Riverside Hotel" seed sẵn ở property-web/apps/api/src/lib/embeddedBootstrap.ts).
TENANT_ID=00000000-0000-0000-0000-00000000d001
PROPERTY_ID=00000000-0000-0000-0000-00000000d101
EDGE_NODE_ID=edge-node-anio-riverside-01

# Chu kỳ (ms) chạy job đồng bộ nền (push outbox + pull dữ liệu mới từ Cloud).
SYNC_INTERVAL_MS=15000

# Bí mật ký JWT cho đăng nhập cục bộ tại Edge Node. QUYẾT ĐỊNH: Edge Node dùng
# vòng đời JWT ĐỘC LẬP với Cloud property-web (không bắt buộc trùng secret) —
# xem README.md mục "Quyết định xác thực" để biết lý do. Nếu muốn token issue ở
# Cloud dùng lại được ở Edge Node (và ngược lại), đặt CÙNG giá trị với
# property-web/apps/api JWT_SECRET.
JWT_SECRET=dev-only-insecure-edge-node-secret-do-not-use-in-production

# Timeout mặc định (giây) cho lệnh thiết bị IoT chưa được ack trước khi
# chuyển sang TIMEOUT — cùng khái niệm với iot-service.
DEFAULT_COMMAND_TIMEOUT_SECONDS=30
