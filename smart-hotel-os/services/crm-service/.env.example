DATABASE_URL=postgresql://crm_service:crm_service@localhost:5432/crm_service?schema=public
PORT=4104
SERVICE_API_KEY=replace-with-a-unique-base64-key-of-at-least-32-characters

# Ngưỡng phân khúc khách (rule-based) — cấu hình qua biến môi trường để dễ
# chỉnh theo từng property mà không sửa code. Xem src/segmentation/engine.ts.
CRM_VIP_MIN_STAYS=5
CRM_VIP_MIN_SPEND=20000000
CRM_INACTIVE_30D_DAYS=30
CRM_INACTIVE_90D_DAYS=90

# NotificationProvider đang cắm — hiện chỉ có "console" (log ra console, không
# gọi nhà cung cấp thật). Khi có SMS/Zalo/Email thật, thêm provider mới trong
# src/providers/ và đổi giá trị này.
NOTIFICATION_PROVIDER=console
