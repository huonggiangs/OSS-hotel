DATABASE_URL=postgresql://iot_service:iot_service@localhost:5432/iot_service?schema=public
PORT=4103

# Số giây mặc định trước khi một lệnh chưa được ack chuyển sang TIMEOUT.
DEFAULT_COMMAND_TIMEOUT_SECONDS=30
# Chu kỳ (ms) quét lệnh PENDING đã quá hạn để chuyển sang TIMEOUT — mô phỏng
# một background job đơn giản trong process, xem README.md.
TIMEOUT_SWEEP_INTERVAL_MS=5000

# Dùng bởi scripts/simulate-device.ts khi gọi vào chính API của service này.
IOT_SERVICE_BASE_URL=http://localhost:4103
