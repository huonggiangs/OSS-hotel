# Copy file này thành .env trước khi chạy `npm run dev` / `npm run migrate` cục bộ.
# Khi chạy qua docker compose (xem services/docker-compose.yml), các biến này được
# docker compose tiêm thẳng, không cần file .env.

DATABASE_URL=postgresql://channel_manager:channel_manager@localhost:5432/channel_manager?schema=public
PORT=4101

# Provider mặc định dùng MockOtaAdapter cho cả 3 kênh vì chưa có tài khoản OTA thật.
# Khi có credentials thật, cắm thêm adapter riêng (vd. BookingComAdapter) trong
# src/adapters/ và đăng ký ở src/adapters/index.ts, KHÔNG sửa business logic core.
OTA_ADAPTER_MODE=mock
