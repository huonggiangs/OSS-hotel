# Tạo file ops/.env bằng scripts/Initialize-OssEnvironment.ps1. Không commit file .env.
# Giá trị bên dưới chỉ là mô tả biến, không phải bí mật dùng thật.
WEBADMIN_JWT_SECRET=
PROPERTY_JWT_SECRET=
EDGE_JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=
SERVICE_API_KEY=

# Tài khoản Cloud chỉ dùng cho đồng bộ Edge -> Property trong môi trường test.
# Khi đổi tài khoản/seed, cập nhật đồng thời hai biến này.
CLOUD_SYNC_USERNAME=reception
CLOUD_SYNC_PASSWORD=Anio2026@

# Định danh fixture demo chung giữa Property và Edge.
TENANT_ID=00000000-0000-0000-0000-00000000d001
PROPERTY_ID=00000000-0000-0000-0000-00000000d101
EDGE_NODE_ID=edge-node-anio-riverside-01
EDGE_WEB_ORIGIN=*
